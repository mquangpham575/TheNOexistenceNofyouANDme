{
  "name": "nonexist-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev -- tsx watch src/server.ts",
    "dev:local": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
